TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Source used for the 5 colors. Default is Binance Prediction/Predict.fun.
PREDICTION_SOURCE=predictfun
PREDICT_API_BASE=https://api.predict.fun
# Optional. Leave blank first; fill this only if the Prediction endpoint requires an API key.
PREDICT_API_KEY=

SYMBOL=BTCUSDT
BASE_BET=1
SECOND_BET=2
START_BALANCE=0
PAYOUT_RATE=0.80
TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
APP_PASSWORD=123

# iPhone dashboard on the same Wi-Fi as the Windows PC.
MOBILE_ENABLED=1
MOBILE_HOST=0.0.0.0
MOBILE_PORT=8765
MOBILE_PASSWORD=1234

# Compatibility values; V4.1 does not use these for Prediction decisions.
DECISION_SECOND=10
MAX_BET=50
DATABASE_PATH=
