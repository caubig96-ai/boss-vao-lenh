# CLOUD MUST use a Telegram bot token separate from the Windows instance.
CLOUD_TELEGRAM_BOT_TOKEN=
CLOUD_TELEGRAM_CHAT_ID=

# Independent cloud trading/signal settings
CLOUD_SYMBOL=BTCUSDT
CLOUD_BASE_BET=1
CLOUD_PAYOUT_RATE=0.80
CLOUD_DECISION_SECOND=10
CLOUD_MAX_BET=50
CLOUD_TIMEZONE=Asia/Ho_Chi_Minh
CLOUD_LOG_LEVEL=INFO

# Leave blank to use ./data/cloud-bot.db on the cloud VM.
CLOUD_DATABASE_PATH=
