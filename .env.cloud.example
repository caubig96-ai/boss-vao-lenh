# Cloud can use the same Telegram bot as Windows in V4.2 because Telegram is send-only.
CLOUD_TELEGRAM_BOT_TOKEN=
CLOUD_TELEGRAM_CHAT_ID=
# Send one Telegram TEST message whenever the cloud service starts/restarts.
CLOUD_TELEGRAM_STARTUP_TEST=1

# Boss V4.2 Prediction-market source
CLOUD_PREDICTION_SOURCE=predictfun
CLOUD_PREDICT_API_BASE=https://api.predict.fun
CLOUD_PREDICT_API_KEY=

CLOUD_SYMBOL=BTCUSDT
CLOUD_BASE_BET=1
CLOUD_SECOND_BET=2
CLOUD_START_BALANCE=0
CLOUD_PAYOUT_RATE=0.80
CLOUD_TIMEZONE=Asia/Ho_Chi_Minh
CLOUD_LOG_LEVEL=INFO

# iPhone dashboard: server keeps running even when PC/iPhone are turned off.
CLOUD_MOBILE_ENABLED=1
CLOUD_MOBILE_HOST=0.0.0.0
CLOUD_MOBILE_PORT=8765
# CHANGE THIS before exposing the dashboard to the Internet.
CLOUD_MOBILE_PASSWORD=change-this-password

# Compatibility values
CLOUD_DECISION_SECOND=10
CLOUD_MAX_BET=50

# Leave blank to use ./data/cloud-bot.db on the cloud VM.
CLOUD_DATABASE_PATH=
