# CLOUD MUST use a Telegram bot token separate from the Windows instance.
CLOUD_TELEGRAM_BOT_TOKEN=
CLOUD_TELEGRAM_CHAT_ID=

# Boss V4.1 Prediction-market source
CLOUD_PREDICTION_SOURCE=predictfun
CLOUD_PREDICT_API_BASE=https://api.predict.fun
CLOUD_PREDICT_API_KEY=

CLOUD_SYMBOL=BTCUSDT
CLOUD_BASE_BET=1
CLOUD_SECOND_BET=2
CLOUD_START_BALANCE=0
CLOUD_PAYOUT_RATE=0.80
CLOUD_TIMEZONE=Asia/Ho_Chi_Minh
CLOUD_LOG_LEVEL=INFO

# Optional web dashboard. Exposing this publicly also requires cloud firewall / HTTPS configuration.
CLOUD_MOBILE_ENABLED=0
CLOUD_MOBILE_HOST=0.0.0.0
CLOUD_MOBILE_PORT=8765

# Compatibility values
CLOUD_DECISION_SECOND=10
CLOUD_MAX_BET=50

# Leave blank to use ./data/cloud-bot.db on the cloud VM.
CLOUD_DATABASE_PATH=
